{
  "mode": "career",
  "roles": {
    "gov": {
      "name": "AI Governance Analyst",
      "text": "You like evidence, structure and finding the gap others missed. Analysts keep the AI inventory, run assessments and turn findings into actions leaders can approve.",
      "steps": [
        "Learn the structure of ISO/IEC 42001 and the NIST AI RMF",
        "Practise building an AI inventory and risk register",
        "Take the AI GRC Practitioner programme"
      ]
    },
    "risk": {
      "name": "AI Risk and Compliance Specialist",
      "text": "You weigh exposure and make the call. Specialists map AI use to law and regulation, run impact assessments and decide which controls a use case needs.",
      "steps": [
        "Study the EU AI Act risk tiers alongside UK GDPR and the NDPA",
        "Run a data protection impact assessment on an AI tool",
        "Pair your experience with an AI risk certification"
      ]
    },
    "policy": {
      "name": "AI Policy and Ethics Advisor",
      "text": "You write guidance people follow and can explain hard trade-offs in plain words. Advisors draft AI policy, lead consultations and advise on fairness and integrity.",
      "steps": [
        "Read three published AI use policies and compare them",
        "Draft an acceptable AI use policy for a team you know",
        "Join a UAICIP or public session on AI ethics"
      ]
    },
    "audit": {
      "name": "AI Assurance and Audit",
      "text": "You test claims and ask for proof. Assurance professionals check whether AI controls work, gather audit evidence and report to boards and regulators.",
      "steps": [
        "Learn how ISO/IEC 42001 audits are planned and evidenced",
        "Practise testing a control end to end",
        "Consider a lead auditor route alongside AI GRC training"
      ]
    },
    "eng": {
      "name": "AI GRC Engineer",
      "text": "You build the systems that make governance real. Engineers automate logging, access control, model monitoring and the evidence trail auditors rely on.",
      "steps": [
        "Learn how audit logs and access control work in AI platforms",
        "Build a small tool that records prompts, sources and outputs",
        "Map your technical skills to ISO/IEC 42001 controls"
      ]
    },
    "lead": {
      "name": "Responsible AI Programme Lead",
      "text": "You bring people with you. Programme leads own the AI governance roadmap, chair the committee and keep training, policy and tools moving together.",
      "steps": [
        "Build a twelve-month responsible AI roadmap for a real organisation",
        "Learn to brief a board on AI risk in under ten minutes",
        "Take the leadership track in our training programmes"
      ]
    }
  },
  "levels": [
    [
      0,
      "Starting point",
      "lv-1",
      "You are early in the journey. Foundations in AI risk and one framework will move you forward fast."
    ],
    [
      5,
